{
  "name": "ws-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal WhatsApp client",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^24.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@24.38.0": true
  }
}
